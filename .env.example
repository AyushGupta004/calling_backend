# Database connection string (defaults to sqlite:///./calling_app.db if omitted)
DATABASE_URL=sqlite:///./calling_app.db

# Coturn / TURN Server Configuration (RFC 5766 / REST API static-auth-secret scheme)
TURN_HOST=turn.example.com
TURN_STATIC_AUTH_SECRET=your-coturn-static-auth-secret-here
TURN_TTL=3600
STUN_URL=stun:stun.l.google.com:19302
